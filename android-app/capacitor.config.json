{
  "appId": "com.hybriddash.app",
  "appName": "HybridDash",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "loggingBehavior": "none",
  "plugins": {
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Searching for cars ...",
        "cancel": "Cancel",
        "availableDevices": "Cars found",
        "noDeviceFound": "No car found"
      }
    },
    "SystemBars": {
      "hidden": true,
      "insetsHandling": "css"
    }
  }
}